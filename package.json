{
  "name": "fazaa",
  "version": "0.2.0",
  "description": "فزعة (Fazaa): women's legal-rights PWA (Palestine). Offline-first, privacy-first.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "npx --yes serve . -l 8080",
    "test": "node --test",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/live-lawyer.mjs",
    "format": "npx --yes prettier --write .",
    "format:check": "npx --yes prettier --check .",
    "dev:admin": "node scripts/dev-server.mjs",
    "lint": "eslint .",
    "check": "npm run format:check && npm run lint && npm test",
    "ai:eval": "node scripts/ai-eval.mjs",
    "law:verify": "node scripts/verify-law.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "playwright": "^1.63.0"
  }
}
